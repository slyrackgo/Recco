# Copy to .env before running docker compose. Replace the sample password.
POSTGRES_DB=recco
DB_USERNAME=recco_user
DB_PASSWORD=replace-with-a-long-random-password

# Local compose defaults; for hosting, use your actual Netlify origin and public backend API URL.
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_PORT=8080
VITE_API_URL=http://localhost:8080/api
