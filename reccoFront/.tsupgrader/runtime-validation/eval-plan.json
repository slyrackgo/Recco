{
  "projectType": "webapp",
  "setup": [
    {
      "command": "npm",
      "args": ["ci"],
      "timeoutSeconds": 600
    }
  ],
  "assertions": [
    {
      "name": "frontend-builds",
      "kind": "process",
      "command": "npm",
      "args": ["run", "build"],
